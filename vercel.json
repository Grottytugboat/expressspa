{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node scripts/prepare.mjs",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/enquiry-reminders",
      "schedule": "0 21 * * *"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/relocations-factory-direct",
      "destination": "/spa-relocation-melbourne",
      "permanent": true
    },
    {
      "source": "/get-a-quote",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "regions": [
    "syd1"
  ]
}